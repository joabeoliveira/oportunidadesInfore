        "jsCode": "const ofertas = $input.all().map(item => ({\n  titulo: item.json.titulo,\n  preco_original: item.json.preco_original,\n  preco_desconto: item.json.preco_desconto,\n  url_afiliado: item.json.url_afiliado,\n  imagem_url: item.json.imagem_url,\n  plataforma: item.json.plataforma\n}));\n\nconst primeiro = $input.first().json;\n\nreturn [{\n  json: {\n    body: ofertas,\n    _productId: primeiro._productId,\n    _commissionRate: primeiro._commissionRate,\n    _sales: primeiro._sales,\n    _searchedCategory: primeiro._searchedCategory,\n    _timestamp: primeiro._timestamp,\n    titulo: primeiro.titulo,\n    preco_original: primeiro.preco_original,\n    preco_desconto: primeiro.preco_desconto,\n    url_afiliado: primeiro.url_afiliado,\n    imagem_url: primeiro.imagem_url,\n    plataforma: primeiro.plataforma\n  }\n}];"
