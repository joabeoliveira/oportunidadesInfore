      "parameters": {
        "jsCode": "// Tratamento de erro e log\n// CORRIGIDO: usa contexto do splitInBatches para pegar categoria correta do batch atual\nconst error = $input.first().json.error;\nconst categoria = $('PROCESSA 1 POR VEZ1').item.json.Categoria;\n\nreturn [{\n  json: {\n    success: false,\n    category: categoria,\n    error: error?.message || 'Unknown error',\n    timestamp: new Date().toISOString(),\n    platform: 'Shopee'\n  }\n}];"
