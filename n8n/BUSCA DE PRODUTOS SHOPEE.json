    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst nodes = p.data?.productOfferV2?.nodes || [];\nconst minPrice = $('⚙️ CONFIGURAÇÕES2').item.json.valorMinimo;\nconst minComm = $('⚙️ CONFIGURAÇÕES2').item.json.comissaoMinima;\nconst minSales = $('⚙️ CONFIGURAÇÕES2').item.json.minimoVendas;\nconst categoriaAtual = $('PROCESSA 1 POR VEZ').item.json.Categoria;\n\nconst mapped = nodes\n  .filter(n => {\n    const price = typeof n.price === 'number' ? n.price : parseFloat(n.price);\n    const comm = n.commissionRate || 0;\n    const sales = n.sales || 0;\n    return price > minPrice && comm >= minComm && sales >= minSales;\n  })\n  .map(n => {\n    const price = typeof n.price === 'number' ? n.price : parseFloat(n.price);\n    const comm = n.commissionRate || 0;\n    const precoDesconto = parseFloat((price * (1 - comm)).toFixed(2));\n    return {\n      titulo: n.productName || \"\",\n      preco_original: price,\n      preco_desconto: precoDesconto,\n      url_afiliado: n.offerLink || n.productLink || \"\",\n      imagem_url: n.imageUrl || \"\",\n      plataforma: \"Shopee\",\n      _productId: String(n.itemId),\n      _commissionRate: comm,\n      _sales: n.sales || 0,\n      _searchedCategory: categoriaAtual,\n      _timestamp: new Date().toISOString()\n    };\n  });\n\nreturn [{\n  json: {\n    produtos: mapped,\n    total: mapped.length,\n    hasProducts: mapped.length > 0\n  }\n}];"
      },
