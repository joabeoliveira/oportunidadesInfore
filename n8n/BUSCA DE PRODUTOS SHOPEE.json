    {
      "parameters": {
        "jsCode": "const ofertas = $input.all().map(item => {\n  const d = item.json;\n  const getField = (keys) => {\n    for (const key of keys) {\n      if (d[key] !== undefined && d[key] !== null) return d[key];\n      if (d[key.toLowerCase()] !== undefined && d[key.toLowerCase()] !== null) return d[key.toLowerCase()];\n    }\n    const lowerKeys = keys.map(k => k.toLowerCase());\n    for (const k in d) {\n      const normalizedK = k.toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n      for (const target of lowerKeys) {\n        const normalizedTarget = target.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n        if (normalizedK === normalizedTarget) {\n          return d[k];\n        }\n      }\n    }\n    return undefined;\n  };\n  const precoOriginal = parseFloat(getField(['Preço', 'Preco', 'Price', 'preco_original'])) || 0;\n  const comissao = parseFloat(getField(['Comissão', 'Comissao', 'Commission', '_commissionRate'])) || 0;\n  const precoDesconto = parseFloat((precoOriginal * (1 - comissao)).toFixed(2));\n  return {\n    titulo: String(getField(['Nome', 'Name', 'titulo', 'productName']) || '').trim(),\n    preco_original: precoOriginal,\n    preco_desconto: precoDesconto,\n    url_afiliado: String(getField(['Link', 'url_afiliado', 'offerLink', 'productLink']) || '').trim(),\n    imagem_url: String(getField(['Imagem', 'imagem_url', 'imageUrl']) || '').trim(),\n    plataforma: 'Shopee'\n  };\n});\nreturn [{\n  json: {\n    body: ofertas\n  }\n}];"
      },
