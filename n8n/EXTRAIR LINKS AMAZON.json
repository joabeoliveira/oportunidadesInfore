            "name": "EXTRAI CARDS HTML"
        },
        {
            "parameters": {
                "jsCode": "const cards = $json.cardHtml || [];\nconst produtos = [];\nconst categoria = $('Loop Over Items').item.json.categoria;\n\nconst cleanText = (html) => {\n  if (!html) return '';\n  return html.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\n};\n\nconst decode = (s) => String(s || '')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>');\n\nfor (const card of cards) {\n  // Extrai Título\n  const titleMatch = card.match(/<h2[^>]*>[\\s\\S]*?<span[^>]*>([\\s\\S]*?)<\\/span>/i);\n  const title = titleMatch ? decode(cleanText(titleMatch[1])) : '';\n  \n  // Extrai Link do Produto\n  const linkMatch = card.match(/<a[^>]*class=\"[^\"]*a-link-normal[^\"]*\"[^>]*href=\"([^\"]+)\"/i) \n    || card.match(/<a[^>]*href=\"([^\"]+)\"[^>]*class=\"[^\"]*a-link-normal[^\"]*\"/i);\n  let link = linkMatch ? decode(linkMatch[1]) : '';\n  if (link && link.startsWith('/')) {\n    link = `https://www.amazon.com.br${link}`;\n  }\n  \n  // Extrai ASIN\n  const asinMatch = link.match(/\\/dp\\/([A-Z0-9]{10})/i) \n    || link.match(/\\/gp\\/product\\/([A-Z0-9]{10})/i) \n    || card.match(/data-asin=\"([A-Z0-9]{10})\"/i);\n  const asin = asinMatch ? asinMatch[1] : '';\n  \n  // Validação mínima\n  if (!title || !link || !asin) continue;\n  \n  // Preço Atual\n  const priceMatch = card.match(/<span class=\"a-offscreen\"[^>]*>([\\s\\S]*?)<\\/span>/i);\n  const priceStr = priceMatch ? cleanText(priceMatch[1]) : '';\n  \n  // Preço Antigo\n  const oldPriceMatch = card.match(/<span class=\"a-price a-text-price\"[^>]*>[\\s\\S]*?<span class=\"a-offscreen\"[^>]*>([\\s\\S]*?)<\\/span>/i);\n  const oldPriceStr = oldPriceMatch ? cleanText(oldPriceMatch[1]) : '';\n  \n  // Rating (Avaliação)\n  const ratingMatch = card.match(/a-icon-alt\">([0-9][0-9.,]*)\\s*de\\s*5/i) \n    || card.match(/a-icon-alt\">([0-9][0-9.,]*)\\s*out\\s*of\\s*5/i);\n  const rating = ratingMatch ? parseFloat(ratingMatch[1].replace(',', '.')) : 0;\n  \n  // Total de Reviews\n  const reviewsMatch = card.match(/<span class=\"a-size-base\"[^>]*>([0-9\\.]+)</i) \n    || card.match(/s-underline-text\">([0-9\\.]+)</i);\n  const reviews = reviewsMatch ? parseInt(reviewsMatch[1].replace(/\\./g, '')) : 0;\n  \n  // Tratamento de preços\n  const parsePrice = (pStr) => {\n    if (!pStr) return null;\n    let clean = pStr.replace(/R\\$/g, '').replace(/\\s/g, '').replace(/\\u00a0/g, '').trim();\n    if (clean.includes('.') && clean.includes(',')) {\n      clean = clean.replace(/\\./g, '').replace(/,/g, '.');\n    } else if (clean.includes(',')) {\n      clean = clean.replace(/,/g, '.');\n    }\n    const val = parseFloat(clean);\n    return isNaN(val) ? null : val;\n  };\n  \n  const precoAtual = parsePrice(priceStr) || 0;\n  const precoOriginal = parsePrice(oldPriceStr) || precoAtual;\n  \n  produtos.push({\n    title,\n    brand: '',\n    current_price: precoAtual,\n    original_price: precoOriginal,\n    star_rating: rating,\n    review_count: reviews,\n    product_url: link,\n    _asin: asin\n  });\n}\n\nreturn [{\n  json: {\n    produtos,\n    total: produtos.length,\n    hasProducts: produtos.length > 0\n  }\n}];"
            },
