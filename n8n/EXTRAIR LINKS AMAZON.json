        {
            "parameters": {
                "jsCode": "const ofertas = $input.all().map(item => {\n  const d = item.json;\n  \n  // Extrai o ASIN da URL do produto\n  const url = d.product_url || '';\n  const asinMatch = url.match(/\\/dp\\/([A-Z0-9]{10})/i) || url.match(/\\/gp\\/product\\/([A-Z0-9]{10})/i);\n  const asin = asinMatch ? asinMatch[1] : '';\n  \n  // Tag de Afiliado Amazon\n  const tagAfiliado = 'seutag-20'; \n  const urlAfiliado = asin ? `https://www.amazon.com.br/dp/${asin}?tag=${tagAfiliado}` : url;\n  \n  // Constrói a URL da imagem usando a CDN estática da Amazon\n  const imagemUrl = asin ? `https://images.amazon.com/images/P/${asin}.01.LZZZZZZZ.jpg` : 'https://www.amazon.com.br/favicon.ico';\n  \n  const precoOriginal = parseFloat(d.original_price) || parseFloat(d.current_price) || 0;\n  const precoDesconto = parseFloat(d.current_price) || 0;\n  \n  return {\n    titulo: String(d.title || '').trim(),\n    preco_original: precoOriginal,\n    preco_desconto: precoDesconto,\n    url_afiliado: urlAfiliado,\n    imagem_url: imagemUrl,\n    plataforma: 'Amazon'\n  };\n});\n\nreturn [{\n  json: {\n    body: ofertas\n  }\n}];"
            },
